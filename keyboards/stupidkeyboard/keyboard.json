{
    "manufacturer": "Simone Orru",
    "keyboard_name": "stupidkeyboard",
    "maintainer": "sorru94",
    "bootloader": "rp2040",
    "diode_direction": "ROW2COL",
    "features": {
        "bootmagic": false,
        "extrakey": true,
        "mousekey": true,
        "nkro": true
    },
    "matrix_pins": {
        // Note GP28 and GP27 are faulty. Luckyly we do not actually use them
        "rows": ["GP28", "GP3", "GP5", "GP4", "GP9", null, null, null, null, null],
        "cols": ["GP27",  "GP2", "GP21", "GP6", "GP7", "GP8"]
    },
    "processor": "RP2040",
    "development_board": "promicro_rp2040",
    "url": "",
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x1234",
        "vid": "0xFEED"
    },
    "split": {
        "enabled": false,
        // "enabled": true,
        "serial": {
            "pin": "GP1"
        }
    },
    "layouts": {
        "LAYOUT_split_3x5_3": {
            "layout": [
                // "matrix": [row, col]
                // "x" and "y" are the coordinates of the key in the physical layout, used for visualizers
                // Row 1 (GP28), cols 1-5 (GP27, GP2, GP21, GP6, GP7, GP8)
                // {"matrix": [0, 0], "x": 0, "y": 0},
                // {"matrix": [0, 1], "x": 1, "y": 0},
                // {"matrix": [0, 2], "x": 2, "y": 0},
                // {"matrix": [0, 3], "x": 3, "y": 0},
                // {"matrix": [0, 4], "x": 4, "y": 0},
                // {"matrix": [0, 5], "x": 5, "y": 0},
                // Row 2 (GP3), cols 1-5 (GP27, GP2, GP21, GP6, GP7, GP8)
                // {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 0, "y": 0},
                {"matrix": [1, 2], "x": 1, "y": 0},
                {"matrix": [1, 3], "x": 2, "y": 0},
                {"matrix": [1, 4], "x": 3, "y": 0},
                {"matrix": [1, 5], "x": 4, "y": 0},
                // Row 3 (GP5), cols 1-5 (GP27, GP2, GP21, GP6, GP7, GP8)
                // {"matrix": [2, 0], "x": 0, "y": 2},
                {"matrix": [2, 1], "x": 0, "y": 1},
                {"matrix": [2, 2], "x": 1, "y": 1},
                {"matrix": [2, 3], "x": 2, "y": 1},
                {"matrix": [2, 4], "x": 3, "y": 1},
                {"matrix": [2, 5], "x": 4, "y": 1},
                // Row 4 (GP4), cols 1-5 (GP27, GP2, GP21, GP6, GP7, GP8)
                // {"matrix": [3, 0], "x": 4, "y": 3},
                {"matrix": [3, 1], "x": 0, "y": 2},
                {"matrix": [3, 2], "x": 1, "y": 2},
                {"matrix": [3, 3], "x": 2, "y": 2},
                {"matrix": [3, 4], "x": 3, "y": 2},
                {"matrix": [3, 5], "x": 4, "y": 2},
                // Row 5 (GP9), cols 1-5 (GP27, GP2, GP21, GP6, GP7, GP8)
                // {"matrix": [4, 0], "x": 15, "y": 2},
                {"matrix": [4, 1], "x": 0, "y": 3},
                // {"matrix": [4, 2], "x": 13, "y": 2},
                {"matrix": [4, 3], "x": 1, "y": 3},
                {"matrix": [4, 4], "x": 2, "y": 3}
                // {"matrix": [4, 5], "x": 10, "y": 2}
            ]
        }
    }
}
